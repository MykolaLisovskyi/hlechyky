# Скопіюй у liquidsoap/.env (або запусти setup.ps1 з кореня, він зробить це сам і згенерує ключі).
# ICECAST_HOST: host.docker.internal, якщо Icecast крутиться на хості (прод); docker-compose.dev.yml сам підставляє "icecast".
ICECAST_HOST=host.docker.internal
ICECAST_PORT=8000
ICECAST_SOURCE_PASSWORD=<IcecastSourcePassword>
ICECAST_MOUNT=radio.mp3
# Резервний потік, коли обидві черги порожні. Нема такого — лишай як є, liquidsoap просто перейде на тишу.
SPOTIFY_FALLBACK_URL=http://host.docker.internal:8000/spotify.mp3
# Куди liquidsoap стукає, коли міняється трек (сервер Hlechyky). Ключ має збігатися з Liquidsoap:ApiKey в appsettings.Local.json.
RT_API_URL=http://host.docker.internal:8080
RT_API_KEY=<LiquidsoapApiKey>
